<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baimo.dsalogserver.mapper.ProblemTagMapper">

    <select id="selectByProblemIds" resultType="com.baimo.dsalogserver.vo.TagRow">
        SELECT pt.problem_id AS problemId, t.id, t.name, t.color
        FROM problem_tag pt
        JOIN tag t ON t.id = pt.tag_id
        WHERE pt.problem_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY t.name
    </select>

    <insert id="insertIgnore">
        INSERT IGNORE INTO problem_tag (problem_id, tag_id)
        VALUES
        <foreach collection="tagIds" item="tagId" separator=",">(#{problemId}, #{tagId})</foreach>
    </insert>

    <!-- 嵌套 foreach：外层按题展开，内层按标签展开，括号内是两个占位符 -->
    <insert id="insertIgnoreBatch">
        INSERT IGNORE INTO problem_tag (problem_id, tag_id)
        VALUES
        <foreach collection="problemIds" item="problemId" separator=",">
            <foreach collection="tagIds" item="tagId" separator=",">(#{problemId}, #{tagId})</foreach>
        </foreach>
    </insert>

    <delete id="deleteByProblemId">
        DELETE FROM problem_tag WHERE problem_id = #{problemId}
    </delete>

    <delete id="deleteByProblemIds">
        DELETE FROM problem_tag WHERE problem_id IN
        <foreach collection="problemIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <delete id="deleteByTagId">
        DELETE FROM problem_tag WHERE tag_id = #{tagId}
    </delete>

    <select id="selectTagIdsByProblemId" resultType="string">
        SELECT tag_id FROM problem_tag WHERE problem_id = #{problemId}
    </select>

</mapper>
