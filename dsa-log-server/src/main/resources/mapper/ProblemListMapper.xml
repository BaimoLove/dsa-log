<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baimo.dsalogserver.mapper.ProblemListMapper">

    <select id="countAlive" resultType="int">
        SELECT COUNT(*) FROM problem_list WHERE id = #{id} AND deleted = 0
    </select>

</mapper>
